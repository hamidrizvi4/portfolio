# Copy to .env.local for local development, and set the same variables in
# Vercel → Project → Settings → Environment Variables.

# Google AI Studio → Get API key. Server-only: never prefix with NEXT_PUBLIC_.
# (The older name GEMINI_API_KEY is still read as a fallback.)
GOOGLE_AI_API_KEY=

# The exact model ID from AI Studio. Empty uses the default in app/api/chat/route.ts.
GOOGLE_AI_MODEL=

# The deployed origin, no trailing slash. Sets metadataBase (absolute og:image
# URLs), sitemap.xml and robots.txt. Empty falls back to https://hamidrizvi.vercel.app;
# set it only if the site moves to another domain.
NEXT_PUBLIC_SITE_URL=
